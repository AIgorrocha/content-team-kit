# ==============================================
# Content Team AI - Variaveis de ambiente
# ==============================================
# Copie este arquivo para .env.local e preencha so o que for usar.
# NUNCA compartilhe nem commite o .env.local. Aqui ficam so os NOMES, sem valor real.
# Sem a chave de uma rede ou ferramenta opcional, a skill correspondente fica desligada.
# O assistente pode preencher os nomes para voce ("conectar as redes"); os valores quem cola
# e voce, direto no arquivo. Conferir sem mostrar valor: npm run kit:checar-chaves -- --rede instagram
# Detalhes por integracao: docs/INTEGRACOES.md
# ==============================================

# --- Banco Supabase (OBRIGATORIO para o painel e o historico; a instalacao local preenche sozinha) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Opcionais do banco
POSTGRES_URL=                  # alternativa ao DATABASE_URL
DATABASE_SSL=                  # "true" se o banco exigir SSL (nuvem)
SALA_LOCAL_DATABASE_URL=       # banco local do painel (preenchido pela instalacao local)

# --- Login e seguranca do painel (OBRIGATORIO para abrir o painel) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=    # chave do cofre de conexoes (32+ caracteres; a instalacao local gera)

# --- Instagram (so se for publicar ou analisar no Instagram) ---
INSTAGRAM_USER_ID=             # preenchido por: node scripts/publishing/instagram-auth-local.mjs
INSTAGRAM_ACCESS_TOKEN=        # idem (token de longa duracao, renovavel)
INSTAGRAM_APP_SECRET=
IG_APP_ID=                     # ID do app principal da Meta
IG_OAUTH_CLIENT_ID=            # ID do app do Instagram (login do Instagram), usado pelo instagram-auth-local
IG_OAUTH_CLIENT_SECRET=        # chave desse mesmo app
IG_HANDLE=                     # @ da conta, sem o @
# Segunda conta de Instagram, de empresa via Meta Business (OPCIONAL)
INSTAGRAM_BUSINESS_USER_ID=
INSTAGRAM_BUSINESS_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_HANDLE=
FB_APP_ID=                     # opcional: app do Facebook, usado em algumas receitas da skill ct-publicar-ig
FB_APP_SECRET=

# --- Threads (OPCIONAL) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_HANDLE=

# --- Resposta automatica a comentarios e DM do Instagram/YouTube (OPCIONAL, servidor proprio) ---
IG_VERIFY_TOKEN=
PUBLIC_BASE=                   # endereco publico HTTPS do servidor, sem barra no final
PORT=3010                      # porta do servidor ig-webhook
OAUTH_SCOPE=                   # opcional: permissoes do login (padrao: basico + comentarios)
RULES_FILE=                    # opcional: regras (padrao data/ig-webhook/rules.json; modelo em scripts/ig-webhook/rules.example.json)
TOKEN_FILE=                    # opcional: onde guardar o token do login da Meta
SEEN_FILE=                     # opcional: comentarios ja respondidos
PENDING_FILE=                  # opcional: quem ainda precisa seguir
LOG_FILE=                      # opcional: log do servidor
DELETIONS_FILE=                # opcional: pedidos de exclusao de dados
YT_VIDEO_IDS=                  # ids dos videos do YouTube acompanhados, separados por virgula
YT_SEEN_FILE=                  # opcional
YT_LOG_FILE=                   # opcional
IG_KEYWORD=GUIA                # so para o gravador de tela do App Review
IG_REEL_URL=                   # so gravador: link de um post real da conta
IG_FOLLOWER_URL=               # so gravador: perfil de uma conta de teste

# --- Meta Ads (OPCIONAL: so para quem roda anuncios) ---
META_ACCESS_TOKEN=             # token de usuario do sistema; ads_read para ler, ads_management para agir
META_AD_ACCOUNT_ID=            # act_..., usado se a marca nao declarar meta_ad_account no brand-profile

# --- LinkedIn (so se for publicar ou analisar no LinkedIn) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=         # preenchido por: node scripts/publishing/linkedin-auth-local.mjs
LINKEDIN_PERSON_ID=            # idem (perfil pessoal)
LINKEDIN_ORG_ID=               # id numerico da pagina de empresa (OPCIONAL)
LINKEDIN_SCOPES=               # opcional: permissoes pedidas no login
LINKEDIN_HANDLE=               # perfil da marca, sem @ (usado nas analises)
LINKEDIN_COMPANY_HANDLE=       # nome da pagina da empresa (OPCIONAL)
LINKEDIN_SEARCH_KEYWORDS=      # palavras separadas por virgula para busca de tendencias

# --- YouTube (OPCIONAL) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=         # preenchido por: node scripts/publishing/youtube-auth.mjs

# --- TikTok (OPCIONAL: a publicacao hoje e pelo navegador logado) ---
TIKTOK_HANDLE=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- X / Twitter (OPCIONAL: publica pelo navegador logado) ---
X_HANDLE=
X_KEYWORDS=                    # palavras para pesquisa de tendencias no X
X_QUEUE_MIRROR_DIR=            # opcional: copia da fila numa pasta sincronizada

# --- Telegram (OPCIONAL: aprovacao de pecas e avisos pelo celular) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_TELEGRAM=               # 1 para mandar o resumo diario de stories no Telegram

# --- IA (OPCIONAL: transcricao, painel e editor de video automatico) ---
OPENAI_API_KEY=                # transcrever audio e video
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CONTENT_TEAM_MODEL=
SALA_ENTREVISTA_MODEL=         # opcional: modelo do assistente de configuracao do painel

# --- Video: ferramentas locais (OPCIONAL) ---
FFMPEG_BIN=                    # caminho do ffmpeg se nao estiver no PATH
FFPROBE_BIN=                   # caminho do ffprobe (padrao: ao lado do ffmpeg)
SELF_EVAL=1                    # 0 desliga a auto-checagem de quadro preto do editor
BROWSER_EXECUTABLE=            # Chrome do sistema para o Remotion
WHISPER=                       # comando do whisper (so a caixa de entrada do iCloud)
CT_MOTION_PLAYWRIGHT_PATH=     # node_modules com playwright, para o motor ct-motion-code

# --- HeyGen (OPCIONAL: avatar digital, servico pago) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# --- Higgsfield (OPCIONAL: video cinematografico, consome creditos) ---
HIGGSFIELD_API_KEY=            # usado pelo painel; o CLI usa login proprio (higgsfield auth login)
HIGGSFIELD_SECRET=
HIGGSFIELD_ENABLED=false       # true liga o caminho pago de criativos em lote
HIGGSFIELD_BIN=higgsfield
HIGGSFIELD_IMG_MODEL=nano_banana
HIGGSFIELD_VID_MODEL=kling2_6
HIGGSFIELD_WAIT_TIMEOUT=12m

# --- Remotion na nuvem / AWS (OPCIONAL: o render local ja e gratis sem isso) ---
REMOTION_AWS_REGION=
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_SERVE_URL=            # o deploy imprime este e os dois abaixo
REMOTION_AWS_BUCKET=
REMOTION_FUNCTION_NAME=
AWS_ACCESS_KEY_ID=             # alternativa a REMOTION_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=

# --- Cloudflare R2 (OPCIONAL: guarda criativos em lote) ---
R2_BUCKET=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Pesquisa de concorrentes (OPCIONAL) ---
RAPIDAPI_KEY=
CT_COMPETITORS_IG=             # perfis de Instagram dos concorrentes, separados por virgula, sem @
SEARXNG_URL=                   # opcional: buscador proprio

# --- Outros opcionais ---
NOTION_TOKEN=                  # scripts avulsos de geracao de guia no Notion
FIGMA_ACCESS_TOKEN=            # leitura de arquivos do Figma
AI_MEMORY_URL=                 # memoria dos agentes (integrations/ai-memory)
AI_MEMORY_AUTH_TOKEN=          # gerado por npm run memory:setup

# --- Ajustes do app (OPCIONAL: cada um so quando voce usa o recurso) ---
CRON_SECRET=
ADMIN_API_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_CLIENT_SLUG=
CT_CLIENT=                     # forca a marca ativa (normalmente vem do .workspace)
CT_ICLOUD_INBOX=               # pasta da caixa de entrada do celular
CT_ICLOUD_BOXES=               # opcional: JSON [{"slug":"...","inbox":"..."}]
CT_COCKPIT_HOST=               # nome do computador que gera o painel diario; vazio roda em qualquer um
CT_IG_DAILY=                   # opcional: intervalo do snapshot diario do Instagram
SOCIAL_INTEL_LOG=              # opcional: onde gravar o log da rotina semanal
NO_PUBLISH=                    # 1 faz os publicadores pelo navegador pararem antes de publicar (teste)
KIT_UPSTREAM_URL=              # opcional: endereco do kit oficial para "atualizar o kit"

# --- Painel: eventos ao vivo do terminal ---
# Senha que scripts/sala/hook-forward.mjs manda para POST /api/sala/eventos/ingest.
# Gerar com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SALA_HOOK_TOKEN=
SALA_URL=http://localhost:5000
SALA_OAUTH_ORIGIN=http://localhost:5000
SALA_DATA=                     # opcional: "mock" (dados de exemplo) ou "live" (banco); padrao: live se houver DATABASE_URL
SALA_LIVE=
SALA_WATCH_POLL=
SALA_LEGACY_TOKEN_CLIENT=
SALA_REGRAS_CLIENT=
SALA_REGRAS_FILE=
SALA_MEMORY_CLIENT=
SALA_MEMORY_PROJECT=
