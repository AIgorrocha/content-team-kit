# Gerado por `npm run memory:setup`. NUNCA commitar o .env (so este .example).
AI_MEMORY_AUTH_TOKEN=troque-por-token-gerado

# Embeddings (busca semantica). Ollama no host com `ollama pull nomic-embed-text`.
# Sem Ollama: apague as 4 linhas abaixo e a memoria roda em modo degradado (so busca por texto).
AI_MEMORY_EMBEDDING_PROVIDER=openai
AI_MEMORY_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
AI_MEMORY_EMBEDDING_MODEL=nomic-embed-text
AI_MEMORY_EMBEDDING_DIM=768

# Consolidacao (resumo periodico das memorias). Opcional e lento em maquina fraca.
# `ollama pull llama3.2:3b`. Sem isso, apague as 4 linhas: a memoria continua funcionando.
AI_MEMORY_LLM_PROVIDER=openai-compat
AI_MEMORY_LLM_BASE_URL=http://host.docker.internal:11434/v1
AI_MEMORY_LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
